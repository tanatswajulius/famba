# Famba Backend — Local Development Defaults
# Copy to .env and customise as needed: cp env.example .env

# Environment: development | staging | production | testing
ENVIRONMENT=development

# Security
SECRET_KEY=change-me-in-production
BASIC_USER=demo
BASIC_PASS=demo123

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite by default; set a postgresql:// URL for Postgres)
DATABASE_URL=sqlite:///./famba.db

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# OSRM routing (public instance used by default)
OSRM_BASE_URL=https://router.project-osrm.org

# Email (leave blank to use the console stub in dev)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_NAME=Famba
# FROM_EMAIL=noreply@famba.app

# Redis (optional)
# REDIS_URL=redis://localhost:6379
