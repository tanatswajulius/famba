# Famba Backend Production Environment Configuration
# Copy this to .env and fill in your values

# Environment: development, staging, production
ENVIRONMENT=production

# API Settings
API_TITLE="Famba Rider API"
API_VERSION="1.0.0"

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Legacy Basic Auth (for backward compatibility)
BASIC_USER=admin
BASIC_PASS=secure-password-here

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://famba:password@postgres:5432/famba
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=famba
POSTGRES_PASSWORD=famba_secret
POSTGRES_DB=famba

# Redis
REDIS_URL=redis://redis:6379

# External Services
SMS_PROVIDER=twilio
SMS_API_KEY=your-twilio-sid
SMS_API_SECRET=your-twilio-auth-token

# Payment
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Maps
MAP_TILE_KEY=your-maptiler-key
OSRM_BASE_URL=https://router.project-osrm.org

# CORS - Restrict in production
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

